{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/setup-e2e.ts",
  "globalTeardown": "<rootDir>/teardown-e2e.ts",
  "setupFilesAfterEnv": ["<rootDir>/setup-after.ts"],
  "testTimeout": 30000
}
